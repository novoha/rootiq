# RootIQ — example secrets file.
#
# LOCAL USE:  copy this file to  .streamlit/secrets.toml  and fill in your key.
#             (.streamlit/secrets.toml is gitignored and will NOT be committed.)
#
# STREAMLIT CLOUD:  do NOT upload a file. Paste the line below into
#                   App → Settings → Secrets in the Streamlit dashboard.
#
# Only needed for ONLINE mode. Offline (local Ollama) needs no key.

OPENAI_API_KEY = "sk-replace-me"

# The base URL and model are set in the app (Settings → LLM Provider) or mcp.json.
# This key works for any OpenAI-compatible endpoint:
#   OpenAI      -> https://api.openai.com/v1
#   Groq (free) -> https://api.groq.com/openai/v1   (key is your Groq key)
#   OpenRouter  -> https://openrouter.ai/api/v1      (key is your OpenRouter key)
